// CRITICAL: CocoaPods configuration MUST be included FIRST
// This fixes the "custom config set" error
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.${CONFIGURATION}.xcconfig"

// Application-level settings for the Runner target.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = CEMS

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.example.cems

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2024 com.example. All rights reserved.

// Set the minimum supported macOS version
MACOSX_DEPLOYMENT_TARGET = 10.15

// Additional settings to ensure proper CocoaPods integration
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES